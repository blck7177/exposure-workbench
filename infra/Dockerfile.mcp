FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY src/ ./src/
RUN pip install --no-cache-dir -e .

# No tiktoken cache, for the reason the worker image gives: measuring a context
# window happens in handle_message, in the api process, never behind this face.

COPY apps/mcp/ ./apps/mcp/
COPY apps/__init__.py ./apps/__init__.py

ENV PYTHONPATH=/app

CMD ["uvicorn", "apps.mcp.http:app", "--host", "0.0.0.0", "--port", "8000"]
