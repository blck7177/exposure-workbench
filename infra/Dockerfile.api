FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY src/ ./src/
RUN pip install --no-cache-dir -e .

# Bake tiktoken's BPE table into the image. Without this the first request after
# every container start fetches it from Azure blob storage into an ephemeral
# /tmp — measured at 1.8s, inside the request path, and dependent on outbound
# internet the rest of the runtime does not need. The worker is deliberately not
# given this: handle_message never runs there.
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken
RUN python -c "import tiktoken; tiktoken.get_encoding('o200k_base')"

COPY apps/api/ ./apps/api/
COPY apps/__init__.py ./apps/__init__.py

ENV PYTHONPATH=/app

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
