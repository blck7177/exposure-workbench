{
 "tag": "NEW03-what-flagged-on-the-run#t2",
 "program": {
  "let": [
   [
    "r",
    {
     "fn": "run",
     "portfolio": "port_001"
    }
   ],
   [
    "current",
    {
     "fn": "column",
     "run": "$r",
     "table": "limit_checks",
     "col": "current_value"
    }
   ],
   [
    "warning",
    {
     "fn": "column",
     "run": "$r",
     "table": "limit_checks",
     "col": "warning_level"
    }
   ],
   [
    "breach",
    {
     "fn": "column",
     "run": "$r",
     "table": "limit_checks",
     "col": "breach_level"
    }
   ],
   [
    "utilisation",
    {
     "fn": "div",
     "a": "$current",
     "b": "$warning"
    }
   ],
   [
    "order",
    {
     "fn": "rank",
     "of": "$utilisation",
     "direction": "highest"
    }
   ],
   [
    "room_to_breach",
    {
     "fn": "sub",
     "a": "$breach",
     "b": "$current"
    }
   ],
   [
    "room_to_warning",
    {
     "fn": "sub",
     "a": "$warning",
     "b": "$current"
    }
   ]
  ]
 },
 "must": [
  "order"
 ],
 "note": "The order to act in: the checks ranked by utilisation of their warning level (MSFT 107%, LLY 106%, JPM 99%, AAPL 98%, gross 91%, Technology 88%...), with room to breach beside each so the answer can separate 'over warning, act' from 'near warning, watch'."
}