     "a": "$MSFT_close_day",
     "b": "$MSFT_close_prev"
    }
   ],
   [
    "MSFT_ret",
    {
     "fn": "div",
     "a": "$MSFT_chg",
     "b": "$MSFT_close_prev"
    }
   ],
   [
    "MSFT_w",
    {
     "fn": "pick",
     "of": "$w",
     "key": "MSFT"
    }
   ],
   [
    "MSFT_contrib",
    {
     "fn": "mul",
     "a": "$MSFT_ret",
     "b": "$MSFT_w"
    }
   ],
   [
