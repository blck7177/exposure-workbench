{
 "tag": "W05-explain-the-day#t1",
 "program": {
  "let": [
   [
    "r",
    {
     "fn": "run",
     "portfolio": "port_001"
    }
   ],
   [
    "book_ret",
    {
     "fn": "pick",
     "of": "$r",
     "key": "exposure_metrics.daily_return"
    }
   ],
   [
    "spy_close_day",
    {
     "fn": "pick",
     "of": {
      "fn": "price",
      "ticker": "SPY",
      "as_of": "2026-09-04"
     },
     "key": "adj_close"
    }
   ],
   [
    "spy_close_prev",
    {
     "fn": "pick",
     "of": {
      "fn": "price",
      "ticker": "SPY",
      "as_of": "2026-09-03"
     },
     "key": "adj_close"
    }
   ],
   [
    "mkt_chg",
    {
     "fn": "sub",
     "a": "$spy_close_day",
     "b": "$spy_close_prev"
    }
   ],
   [
    "mkt_ret",
    {
     "fn": "div",
     "a": "$mkt_chg",
     "b": "$spy_close_prev"
    }
   ],
   [
    "rec",
    {
     "fn": "method",
     "name": "book.reconcile",
     "subject": "$r"
    }
   ],
   [
    "factor_sum",
    {
     "fn": "pick",
     "of": "$rec",
     "key": "sum_of_factor_contributions"
    }
   ],
   [
    "residual",
    {
     "fn": "pick",
     "of": "$rec",
     "key": "alpha_plus_residual"
    }
   ],
   [
    "factor_share",
    {
     "fn": "pick",
     "of": "$rec",
     "key": "factor_share"
    }
   ],
   [
    "unexplained_share",
    {
     "fn": "pick",
     "of": "$rec",
     "key": "unexplained_share"
    }
   ],
   [
    "w",
    {
     "fn": "column",
     "run": "$r",
     "table": "issuer_exposures",
     "col": "weight"
    }
   ],
   [
    "MSFT_close_day",
    {
     "fn": "pick",
     "of": {
      "fn": "price",
      "ticker": "MSFT",
      "as_of": "2026-09-04"
     },
     "key": "adj_close"
    }
   ],
   [
