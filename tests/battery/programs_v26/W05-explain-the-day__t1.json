  ]
 },
 "must": [
  "book_ret",
  "mkt_ret",
  "factor_share",
  "unexplained_share"
 ],
 "note": "Book's return on the run day (exposure_metrics.daily_return) beside SPY's same-day return from two closes; book.reconcile splits it into the factor-explained sum and the alpha+residual, as shares. The run holds no per-position contribution table and book.explain_episode refuses a one-day window (insufficient_history), so contributions are rebuilt as weight x day-return for the five largest weights."
}