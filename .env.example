# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://exposure:exposure@localhost:5432/exposure_workbench
DATABASE_URL_SYNC=postgresql+psycopg2://exposure:exposure@localhost:5432/exposure_workbench

# ─── LLM API Keys (at least one required for report agent) ────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Model preferences ────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
EMBEDDING_MODEL=text-embedding-3-small

# ─── Issuer Intelligence providers ────────────────────────────────────────────
# Tavily (external market research, M6) — https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
# SEC EDGAR requires a User-Agent with contact info (M2). Format: "Name email@domain"
EDGAR_IDENTITY=Your Name your_email@example.com

# ─── Identity: Clerk (V2-A multi-user) ────────────────────────────────────────
# Backend verifies Clerk RS256 session JWTs via JWKS — no secret key needed.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3103
# Frontend (build-time, must be NEXT_PUBLIC_): publishable key from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# ─── Report agent mode ────────────────────────────────────────────────────────
# Options: direct_llm | langgraph
REPORT_AGENT_MODE=direct_llm

# ─── Service ports ────────────────────────────────────────────────────────────
API_HOST_PORT=8103
WEB_HOST_PORT=3103
POSTGRES_HOST_PORT=5433

# ─── App settings ─────────────────────────────────────────────────────────────
DEMO_MODE=true
WORKER_POLL_INTERVAL=2
# V2-E1 worker lease. Not renewed: a task whose lease expires is treated as
# abandoned. Must exceed the slowest real task (a cold issuer_research).
TASK_LEASE_SECONDS=1800
# Applies only to replay-safe task types; the others fail on first expiry.
TASK_MAX_RETRIES=3
LOG_LEVEL=INFO

# ─── External data (optional, for live market data pull) ──────────────────────
FRED_API_KEY=your_fred_api_key_here

# ─── Daily quota (V2-E3) ──────────────────────────────────────────────────────
# The unit is a USER ACTION per UTC day, not tokens or tool calls. GLOBAL_* is a
# shared backstop across every user — the last line of defence for a public link.
# Orthogonal to the per-session budgets above (those bound one conversation).
TURN_LEASE_SECONDS=900
DAILY_CHAT_TURNS=10
DAILY_RESEARCH_RUNS=3
DAILY_READINESS=10
DAILY_EXPOSURE_RUNS=20
DAILY_MARKET_SYNCS=10
GLOBAL_DAILY_CHAT_TURNS=200
GLOBAL_DAILY_RESEARCH_RUNS=30
GLOBAL_DAILY_READINESS=100
GLOBAL_DAILY_EXPOSURE_RUNS=200
GLOBAL_DAILY_MARKET_SYNCS=50
