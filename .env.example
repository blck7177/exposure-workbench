# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://exposure:exposure@localhost:5432/exposure_workbench
DATABASE_URL_SYNC=postgresql+psycopg2://exposure:exposure@localhost:5432/exposure_workbench

# ─── LLM API Keys (at least one required for report agent) ────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Model preferences ────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
EMBEDDING_MODEL=text-embedding-3-small

# ─── Issuer Intelligence providers ────────────────────────────────────────────
# Tavily (external market research, M6) — https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
# SEC EDGAR requires a User-Agent with contact info (M2). Format: "Name email@domain"
EDGAR_IDENTITY=Your Name your_email@example.com

# ─── Report agent mode ────────────────────────────────────────────────────────
# Options: direct_llm | langgraph
REPORT_AGENT_MODE=direct_llm

# ─── Service ports ────────────────────────────────────────────────────────────
API_HOST_PORT=8103
WEB_HOST_PORT=3103
POSTGRES_HOST_PORT=5433

# ─── App settings ─────────────────────────────────────────────────────────────
DEMO_MODE=true
WORKER_POLL_INTERVAL=2
LOG_LEVEL=INFO

# ─── External data (optional, for live market data pull) ──────────────────────
FRED_API_KEY=your_fred_api_key_here
