# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://exposure:exposure@localhost:5432/exposure_workbench

# ─── LLM API Keys (at least one required for report agent) ────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Model preferences ────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# ─── Issuer Intelligence providers ────────────────────────────────────────────
# Tavily (external market research, M6) — https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
# SEC EDGAR requires a User-Agent with contact info (M2). Format: "Name email@domain"
EDGAR_IDENTITY=Your Name your_email@example.com

# ─── Identity: Clerk (V2-A multi-user) ────────────────────────────────────────
# Backend verifies Clerk RS256 session JWTs via JWKS — no secret key needed.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3103
# Frontend (build-time, must be NEXT_PUBLIC_): publishable key from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# ─── Report agent mode ────────────────────────────────────────────────────────
# Options: direct_llm | langgraph
REPORT_AGENT_MODE=direct_llm

# ─── Service ports ────────────────────────────────────────────────────────────
API_HOST_PORT=8103
WEB_HOST_PORT=3103
POSTGRES_HOST_PORT=5433

# ─── App settings ─────────────────────────────────────────────────────────────
DEMO_MODE=true
WORKER_POLL_INTERVAL=2
# V2-E1 worker lease. Not renewed: a task whose lease expires is treated as
# abandoned. Must exceed the slowest real task (a cold issuer_research).
TASK_LEASE_SECONDS=1800
# Applies only to replay-safe task types; the others fail on first expiry.
TASK_MAX_RETRIES=3
LOG_LEVEL=INFO

# ─── MCP tool face (MCP_PLAN R3) ──────────────────────────────────────────────
# The tool face is its own container (exposure-mcp), reachable only on the
# compose network. Every call carries an internal HS256 JWT the api mints per
# turn and the worker per run; this is the shared signing key, and it must be a
# long random string — `openssl rand -hex 32`. Left empty, the api, the worker
# and the mcp container each fail loud at startup; nothing runs unsigned.
MCP_INTERNAL_SECRET=generate_with_openssl_rand_hex_32
# Where the api and the worker reach it. No host port exists, by design.
# MCP_URL itself is compose's wiring (the service name) and is deliberately NOT
# set here: a value in .env is substituted into the containers too, so a host
# address written here would send the api and the worker somewhere that does not
# exist from inside the network. The host needs its own name for the same face:
MCP_HOST_PORT=8104
MCP_URL_LOCAL=http://localhost:8104
# The token lives 30 minutes, the same span as TASK_LEASE_SECONDS above: it
# outlives the longest legitimate run and dies before an abandoned one.

# ─── External data (optional, for live market data pull) ──────────────────────
FRED_API_KEY=your_fred_api_key_here

# ─── Daily quota (V2-E3) ──────────────────────────────────────────────────────
# The unit is a USER ACTION per UTC day, not tokens or tool calls. GLOBAL_* is a
# shared backstop across every user — the last line of defence for a public link.
# Orthogonal to the per-session budgets above (those bound one conversation).
TURN_LEASE_SECONDS=900
DAILY_CHAT_TURNS=10
DAILY_RESEARCH_RUNS=3
DAILY_READINESS=10
DAILY_EXPOSURE_RUNS=20
DAILY_MARKET_SYNCS=10
GLOBAL_DAILY_CHAT_TURNS=200
GLOBAL_DAILY_RESEARCH_RUNS=30
GLOBAL_DAILY_READINESS=100
GLOBAL_DAILY_EXPOSURE_RUNS=200
GLOBAL_DAILY_MARKET_SYNCS=50
